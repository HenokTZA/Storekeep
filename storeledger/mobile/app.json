{
  "expo": {
    "name": "StoreLedger",
    "slug": "storeledger",
    "version": "1.4.0",
    "orientation": "portrait",
    "scheme": "storeledger",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "android": {
      "package": "com.storeledger.app",
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.storeledger.app",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
