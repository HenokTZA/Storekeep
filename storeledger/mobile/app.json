{
  "expo": {
    "name": "StoreLedger",
    "slug": "storeledger",
    "owner": "henoktza",
    "version": "1.6.0",
    "orientation": "portrait",
    "scheme": "storeledger",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "android": {
      "package": "com.storeledger.app",
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.storeledger.app",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "8eb196bc-a7c6-4b7f-98d3-9a06ee58d53a"
      }
    }
  }
}
