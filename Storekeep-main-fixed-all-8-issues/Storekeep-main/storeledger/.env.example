# Public host
DOMAIN=api.example.com
DJANGO_ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32

# PostgreSQL
POSTGRES_DB=storeledger
POSTGRES_USER=storeledger
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://storeledger:replace-with-a-long-random-password@db:5432/storeledger

# Queue
REDIS_URL=redis://redis:6379/0

# SMS: console is safe for initial testing. Adapt the provider payload if required.
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=StoreLedger

